{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FigureAssetLicense",
  "type": "object",
  "required": ["source", "rights", "usage"],
  "properties": {
    "source": { "type": "string", "description": "출처 (소장처/URL/저작자)" },
    "rights": { "type": "string", "description": "권리 상태 (예: Public Domain, CC BY 4.0)" },
    "usage": { "type": "string", "description": "허용 사용 범위" },
    "verifiedAt": { "type": "string", "format": "date", "description": "확인 일자" }
  }
}
